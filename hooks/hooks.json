{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c pass && python \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_locked_files.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/protect_locked_files.py\""
          }
        ]
      }
    ]
  }
}
